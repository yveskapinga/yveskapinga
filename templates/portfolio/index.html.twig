{% extends 'base.html.twig' %}

{% block title %}{{ 'meta.title'|trans }}{% endblock %}

{% block body %}
    <main class="portfolio-page">
        <div class="scroll-progress" aria-hidden="true">
            <span id="scroll-progress-bar"></span>
        </div>

        <header class="topbar">
            <div class="container topbar__inner">
                <a class="brand" href="#top">
                    <span class="brand__name">Yves Kayembe</span>
                    <span class="brand__role">{{ 'hero.eyebrow'|trans }}</span>
                </a>
                <nav class="topbar__nav" aria-label="{{ 'nav.aria'|trans }}">
                    <a href="#about">{{ 'nav.about'|trans }}</a>
                    <a href="#experience">{{ 'nav.experience'|trans }}</a>
                    <a href="#projects">{{ 'nav.projects'|trans }}</a>
                    <a href="#credentials">{{ 'nav.credentials'|trans }}</a>
                    <a href="#contact">{{ 'nav.contact'|trans }}</a>
                </nav>
                <a class="locale-switch" href="{{ path('app_portfolio', { lang: switchLocale }) }}">
                    {{ ('meta.switch_' ~ switchLocale)|trans }}
                </a>
            </div>
        </header>

        <aside class="side-anchor-nav" aria-label="{{ 'nav.aria'|trans }}">
            <a href="#top" data-anchor>{{ 'nav.top'|trans }}</a>
            <a href="#about" data-anchor>{{ 'nav.about'|trans }}</a>
            <a href="#experience" data-anchor>{{ 'nav.experience'|trans }}</a>
            <a href="#projects" data-anchor>{{ 'nav.projects'|trans }}</a>
            <a href="#credentials" data-anchor>{{ 'nav.credentials'|trans }}</a>
            <a href="#contact" data-anchor>{{ 'nav.contact'|trans }}</a>
        </aside>

        <section class="hero section" id="top" data-section data-reveal>
            <div class="hero__bg-shape hero__bg-shape--one"></div>
            <div class="hero__bg-shape hero__bg-shape--two"></div>
            <div class="container hero__layout">
                <div class="hero__content">
                    <p class="eyebrow">{{ 'hero.eyebrow'|trans }}</p>
                    <h1>{{ 'hero.name'|trans }}</h1>
                    <p class="lead">{{ 'hero.role'|trans }}</p>
                    <p class="intro">{{ 'hero.intro'|trans }}</p>
                    <ul class="hero__highlights">
                        <li>{{ 'hero.highlights.1'|trans }}</li>
                        <li>{{ 'hero.highlights.2'|trans }}</li>
                        <li>{{ 'hero.highlights.3'|trans }}</li>
                    </ul>
                    <div class="hero__meta">
                        <span>{{ 'hero.location'|trans }}</span>
                        <a href="mailto:yveskapinga@gmail.com">{{ 'hero.contact_email'|trans }}</a>
                        <a href="tel:+243998615075">{{ 'hero.contact_phone'|trans }}</a>
                        <a href="https://github.com/yveskapinga" target="_blank" rel="noopener noreferrer">github.com/yveskapinga</a>
                    </div>
                    <div class="hero__actions">
                        <a class="btn" href="{{ locale == 'fr' ? '/documents/Yves_Kayembe_CV_fr.pdf' : '/documents/Yves_Kayembe_CV_en.pdf' }}" target="_blank" rel="noopener noreferrer">{{ 'hero.download_cv'|trans }}</a>
                        <a class="btn btn--secondary" href="#projects">{{ 'hero.cta'|trans }}</a>
                    </div>
                    <div class="metrics-grid">
                        <article class="metric-card" data-reveal>
                            <strong>{{ 'metrics.items.1.value'|trans }}</strong>
                            <span>{{ 'metrics.items.1.label'|trans }}</span>
                        </article>
                        <article class="metric-card" data-reveal>
                            <strong>{{ 'metrics.items.2.value'|trans }}</strong>
                            <span>{{ 'metrics.items.2.label'|trans }}</span>
                        </article>
                        <article class="metric-card" data-reveal>
                            <strong>{{ 'metrics.items.3.value'|trans }}</strong>
                            <span>{{ 'metrics.items.3.label'|trans }}</span>
                        </article>
                    </div>
                </div>
                <aside class="hero__side">
                    <article class="profile-card" data-reveal>
                        <img class="profile-card__avatar" src="/pictures/photo_profil.jpg" alt="{{ 'hero.photo_alt'|trans }}">
                        <div class="profile-card__body">
                            <p class="profile-card__label">{{ 'profile.label'|trans }}</p>
                            <h2>{{ 'profile.title'|trans }}</h2>
                            <p>{{ 'profile.summary'|trans }}</p>
                            <ul class="profile-card__facts">
                                <li>{{ 'profile.facts.1'|trans }}</li>
                                <li>{{ 'profile.facts.2'|trans }}</li>
                                <li>{{ 'profile.facts.3'|trans }}</li>
                            </ul>
                        </div>
                    </article>
                    <article class="credential-card credential-card--link" data-reveal>
                        <div class="credential-card__body">
                            <p class="credential-card__label">{{ 'cert.highlight_label'|trans }}</p>
                            <h3>{{ 'cert.highlight_title'|trans }}</h3>
                            <p>{{ 'cert.highlight_text'|trans }}</p>
                            <button class="text-link" data-cert-trigger="lead-auditor">{{ 'cert.link'|trans }}</button>
                        </div>
                    </article>
                </aside>
            </div>
        </section>

        <section class="positioning-strip" data-reveal>
            <div class="container positioning-strip__grid">
                {% for item in 1..3 %}
                    <article class="positioning-card" data-reveal>
                        <p class="positioning-card__kicker">{{ ('positioning.items.' ~ item ~ '.kicker')|trans }}</p>
                        <h2>{{ ('positioning.items.' ~ item ~ '.title')|trans }}</h2>
                        <p>{{ ('positioning.items.' ~ item ~ '.body')|trans }}</p>
                    </article>
                {% endfor %}
            </div>
        </section>

        <section class="section section--light" id="about" data-section data-reveal>
            <div class="container grid two-columns">
            <article class="panel panel--editorial" data-reveal>
                    <h2>{{ 'summary.title'|trans }}</h2>
                    <p>{{ 'summary.body'|trans }}</p>
                    <blockquote class="editorial-quote">
                        {{ 'summary.quote'|trans }}
                    </blockquote>
                </article>
                <article class="panel" data-reveal>
                    <h2>{{ 'skills.title'|trans }}</h2>
                    <ul class="tag-list tag-list--chips">
                        <li>{{ 'skills.items.1'|trans }}</li>
                        <li>{{ 'skills.items.2'|trans }}</li>
                        <li>{{ 'skills.items.3'|trans }}</li>
                        <li>{{ 'skills.items.4'|trans }}</li>
                        <li>{{ 'skills.items.5'|trans }}</li>
                        <li>{{ 'skills.items.6'|trans }}</li>
                        <li>{{ 'skills.items.7'|trans }}</li>
                        <li>{{ 'skills.items.8'|trans }}</li>
                        <li>{{ 'skills.items.9'|trans }}</li>
                    </ul>
                    <div class="delivery-block">
                        <p class="delivery-block__title">{{ 'delivery.title'|trans }}</p>
                        <ul class="info-list">
                            {% for item in 1..3 %}
                                <li>{{ ('delivery.items.' ~ item)|trans }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                </article>
            </div>
        </section>

        <section class="section" id="experience" data-section data-reveal>
            <div class="container">
                <h2>{{ 'experience.title'|trans }}</h2>
                <div class="timeline">
                    {% for item in 1..9 %}
                        <article class="timeline__item" data-reveal>
                            <h3>{{ ('experience.items.' ~ item ~ '.title')|trans }}</h3>
                            <p class="period">{{ ('experience.items.' ~ item ~ '.period')|trans }}</p>
                            <p>{{ ('experience.items.' ~ item ~ '.body')|trans }}</p>
                        </article>
                    {% endfor %}
                </div>
            </div>
        </section>

        <section class="section section--light" id="projects" data-section data-reveal>
            <div class="container">
                <div class="section-heading">
                    <div>
                        <p class="section-heading__eyebrow">{{ 'projects.eyebrow'|trans }}</p>
                        <h2>{{ 'projects.title'|trans }}</h2>
                    </div>
                    <p class="section-heading__body">{{ 'projects.intro'|trans }}</p>
                </div>
                <div class="grid cards cards--projects">
                    {% for item in 1..7 %}
                        <article class="card {{ item == 1 ? 'card--featured' : '' }}" data-reveal>
                            <span class="project-index">0{{ item }}</span>
                            <p class="card__kicker">{{ ('projects.items.' ~ item ~ '.kicker')|trans }}</p>
                            <h3>{{ ('projects.items.' ~ item ~ '.title')|trans }}</h3>
                            <p>{{ ('projects.items.' ~ item ~ '.body')|trans }}</p>
                            <p class="project-outcome">{{ ('projects.items.' ~ item ~ '.outcome')|trans }}</p>
                        </article>
                    {% endfor %}
                </div>
            </div>
        </section>

        <section class="section" id="credentials" data-section data-reveal>
            <div class="container grid three-columns">
            <article class="panel" data-reveal>
                    <h2>{{ 'education.title'|trans }}</h2>
                    <ul class="info-list">
                        {% for item in 1..2 %}
                            <li>
                                <strong>{{ ('education.items.' ~ item ~ '.title')|trans }}</strong>
                                <span>{{ ('education.items.' ~ item ~ '.body')|trans }}</span>
                            </li>
                        {% endfor %}
                    </ul>
                </article>
                <article class="panel" data-reveal>
                    <h2>{{ 'certifications.title'|trans }}</h2>
                    <ul class="info-list">
                        {% for item in 1..6 %}
                            <li>{{ ('certifications.items.' ~ item)|trans }}</li>
                        {% endfor %}
                    </ul>
                </article>
                <article class="panel" data-reveal>
                    <h2>{{ 'languages.title'|trans }}</h2>
                    <ul class="info-list">
                        {% for item in 1..3 %}
                            <li>{{ ('languages.items.' ~ item)|trans }}</li>
                        {% endfor %}
                    </ul>
                </article>
            </div>
        </section>

        <section class="section section--light" data-reveal>
            <div class="container grid two-columns">
            <article class="panel" data-reveal>
                    <h2>{{ 'strengths.title'|trans }}</h2>
                    <ul class="info-list">
                        {% for item in 1..4 %}
                            <li>{{ ('strengths.items.' ~ item)|trans }}</li>
                        {% endfor %}
                    </ul>
                </article>
                <article class="panel panel--documents" data-reveal>
                    <h2>{{ 'documents.title'|trans }}</h2>
                    <p>{{ 'documents.body'|trans }}</p>
                    <div class="documents__actions">
                        <a class="btn" href="/documents/Yves_Kayembe_CV_fr.pdf" target="_blank" rel="noopener noreferrer">{{ 'documents.download_fr'|trans }}</a>
                        <a class="btn btn--outline" href="/documents/Yves_Kayembe_CV_en.pdf" target="_blank" rel="noopener noreferrer">{{ 'documents.download_en'|trans }}</a>
                        <button class="btn btn--outline" data-cert-trigger="lead-auditor">{{ 'documents.view_certificate'|trans }}</button>
                    </div>
                </article>
            </div>
        </section>

        <section class="section section--accent" id="contact" data-section data-reveal>
            <div class="container contact">
                <h2>{{ 'contact.title'|trans }}</h2>
                <p>{{ 'contact.body'|trans }}</p>
                <div class="contact__actions">
                    <a class="btn" href="mailto:yveskapinga@gmail.com">{{ 'contact.email'|trans }}</a>
                    <a class="btn btn--ghost" href="https://github.com/yveskapinga" target="_blank" rel="noopener noreferrer">{{ 'contact.github'|trans }}</a>
                </div>
            </div>
        </section>

        <footer class="portfolio-footer" data-reveal>
            <div class="container portfolio-footer__inner">
                <p>{{ 'footer.note'|trans }}</p>
            </div>
        </footer>

        <!-- Certificate Modal -->
        <div class="certificate-modal" id="certificate-modal" role="dialog" aria-modal="true" aria-labelledby="cert-modal-title">
            <div class="certificate-modal__overlay" data-cert-close></div>
            <div class="certificate-modal__content">
                <button class="certificate-modal__close" data-cert-close aria-label="Fermer"></button>
                <div class="certificate-modal__image-container">
                    <img class="certificate-modal__image" src="/pictures/lead_auditor_certificate.jpg" alt="Certificat Lead Auditor" draggable="false" />
                </div>
            </div>
        </div>
    </main>
{% endblock %}
